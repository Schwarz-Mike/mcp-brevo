# ============================================================
#  mcp-brevo — environment configuration
#  Copy to .env and fill in. NEVER commit the real .env.
# ============================================================

# --- Web server (build/server.js) ---

# Public base URL — must match the domain served by nginx. No trailing slash.
PUBLIC_URL=https://mcp-brevo.mikeschwarz.ch

# Local port the Node app listens on (nginx proxies to 127.0.0.1:PORT).
PORT=3104

# 64-char hex (32 bytes) — encrypts the Brevo API keys at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Long random string (>= 64 chars) — signs session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Initial admin user — seeded on first start if it does not exist yet.
ADMIN_USERNAME=mike
ADMIN_PASSWORD=
ADMIN_EMAIL=mike.schwarz@hypnosetherapie.pro

# --- stdio shim only (build/index.js, optional local single-tenant test) ---
# Not used by the web server. Create a key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
